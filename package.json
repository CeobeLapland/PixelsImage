{
  "name": "pixelsimage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "把高清图转换为 Minecraft 风格低分辨率像素图，并支持逐块手工微调",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:offline": "tsc --noEmit && vite build --mode offline",
    "build:cli": "esbuild cli/main.ts --bundle --platform=node --format=esm --target=node22 --alias:@=./src --outfile=dist-cli/pixcli.mjs --banner:js=\"#!/usr/bin/env node\" --log-level=warning",
    "pixcli": "node dist-cli/pixcli.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "bin": {
    "pixcli": "dist-cli/pixcli.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.1"
  }
}
